rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Any email-authed user is admin — no extra Firestore read needed
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function playerFinished(roundId) {
      let pr = get(/databases/$(database)/documents/rounds/$(roundId)/playerRounds/$(request.auth.uid));
      return pr.data.status == 'solved' || pr.data.status == 'surrendered';
    }

    function roundCompleted(roundId) {
      let r = get(/databases/$(database)/documents/rounds/$(roundId));
      return r.data.status == 'completed';
    }

    // ── Game state singleton ───────────────────────────────────────────────
    match /gameState/{docId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Rounds (top-level) ────────────────────────────────────────────────
    match /rounds/{roundId} {
      // Players can read the round doc (contains terms[] for local lookup)
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;

      // private/secret: admin always; player only after finishing or round completed
      match /private/{docId} {
        allow read: if isAdmin()
          || (signedIn() && (playerFinished(roundId) || roundCompleted(roundId)));
        allow create, update, delete: if isAdmin();
      }

      // playerRounds: self read/write; admin read
      match /playerRounds/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid);
        allow delete: if false;
      }

      // publicResults: all signed-in can read; self or admin write
      match /publicResults/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid) || isAdmin();
        allow delete: if false;
      }

      // liveProgress: live best rank per player (no guess words). All read; self writes.
      match /liveProgress/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid);
        allow delete: if isAdmin();
      }
    }

    // ── Players (top-level) ───────────────────────────────────────────────
    match /players/{uid} {
      allow read: if signedIn();
      // Cap 10 concurrent players (spec §15.6) — count includes admin if admin plays.
      allow create: if isSelf(uid)
        && get(/databases/$(database)/documents/gameState/main).data.playerCount < 10;
      allow update: if isSelf(uid) || isAdmin();
      // Admin deletes player docs when opening a new session (totalScore reset, spec §15.2).
      allow delete: if isAdmin();
    }

    // ── History games (completed game summaries) ──────────────────────────
    match /historyGames/{roundId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
